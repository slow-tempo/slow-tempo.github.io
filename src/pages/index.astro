---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const rawPosts = await getCollection('posts');

const postsData = rawPosts.map(post => ({
  slug: post.slug || post.id.replace(/\.[^/.]+$/, ""),
  title: post.data.title,
  date: post.data.date,
  category: post.data.category,
  summary: post.data.summary || '',
  content: post.body || '',
}));

const categories = ['All', ...new Set(rawPosts.map(p => p.data.category))];
---

<BaseLayout>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 relative">

    <!--
      ============================================================
      메인 + 사이드바
      ============================================================
    -->
    <div
      id="homeLayout"
      class="flex items-stretch justify-center relative gap-8 w-full transition-all duration-300"
    >

      <!--
        ==========================================================
        1. MAIN
        ==========================================================
      -->
      <main
        id="homeMain"
        class="flex-1 min-w-0 transition-all duration-300 space-y-6"
      >

        <!-- 카테고리 + 정렬 -->
        <div class="flex items-center justify-between gap-4 pb-2">

          <!-- Category -->
          <div
            id="categoryGroup"
            class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar"
          >

            {categories.map((cat) => (
              <button
                class={`cat-btn px-4 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition ${
                  cat === 'All'
                    ? 'bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 shadow-sm'
                    : 'bg-neutral-100 text-neutral-600 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-700'
                }`}
                data-cat={cat}
              >
                {cat}
              </button>
            ))}

          </div>

          <!-- Sort -->
          <button
            id="sortBtn"
            class="shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[#E5E5E5] dark:border-[#2E2E2E] text-xs font-semibold text-neutral-700 dark:text-neutral-300 bg-white dark:bg-[#1E1E1E] hover:border-neutral-400 transition shadow-sm"
          >
            <span id="sortLabel">NEW</span>
          </button>

        </div>


        <!-- 게시물 수 -->
        <div class="text-xs text-[#737373]">
          Total
          <span
            id="countNum"
            class="font-bold text-neutral-900 dark:text-white"
          >
            {postsData.length}
          </span>
          posts
        </div>


        <!-- 게시물 -->
        <div
          class="space-y-4"
          id="postContainer"
        ></div>


        <!-- 검색 결과 없음 -->
        <div
          id="noResults"
          class="hidden py-16 text-center text-xs text-[#737373] bg-white dark:bg-[#1E1E1E] rounded-xl border border-[#E5E5E5] dark:border-[#2E2E2E]"
        >
          검색 조건과 일치하는 포스트가 없습니다.
        </div>

      </main>


      <!--
        ==========================================================
        2. SIDEBAR
        글 페이지의 Index와 동일한 "폭 접기" 방식
        ==========================================================
      -->

      <aside
        id="homeSidebar"
        class="
          w-[280px]
          max-w-[30%]
          shrink-0
          bg-transparent
          rounded-2xl
          text-xs
          transition-all
          duration-300
          relative
          overflow-hidden
          flex
          flex-col
          group
          hidden
          md:flex
        "
      >

        <!--
          --------------------------------------------------------
          접기 / 펼치기 핸들
          --------------------------------------------------------
        -->
        <button
          id="sidebarHandle"
          type="button"
          class="
            absolute
            left-0
            top-0
            bottom-0
            w-8
            flex
            items-center
            justify-center
            z-20
            bg-neutral-50/50
            dark:bg-neutral-800/30
            group-hover:bg-neutral-200/60
            dark:group-hover:bg-neutral-700/60
            transition-colors
            border-r
            border-[#E5E5E5]/50
            dark:border-[#2E2E2E]/50
            cursor-pointer
          "
          title="사이드바 접기/펼치기"
        >
          <span
            id="sidebarToggleIcon"
            class="text-neutral-800 dark:text-neutral-100 font-extrabold text-base"
          >
            ›
          </span>
        </button>


        <!--
          --------------------------------------------------------
          Sidebar Content
          --------------------------------------------------------
        -->
        <div
          id="sidebarContent"
          class="
            pl-10
            w-full
            transition-opacity
            duration-200
            space-y-6
          "
        >

          <!-- 프로필 -->
          <div
            class="
              bg-white
              dark:bg-[#1E1E1E]
              p-6
              rounded-2xl
              border
              border-[#E5E5E5]
              dark:border-[#2E2E2E]
              shadow-sm
            "
          >

            <div
              class="font-bold text-neutral-900 dark:text-white text-base mb-1"
            >
              slow-tempo
            </div>

            <p
              class="text-xs text-[#737373] leading-relaxed"
            >
              알고리즘, 수식, 시스템 구현을 기록합니다.
            </p>

          </div>


          <!-- 검색 -->
          <div
            class="
              bg-white
              dark:bg-[#1E1E1E]
              p-4
              rounded-2xl
              border
              border-[#E5E5E5]
              dark:border-[#2E2E2E]
              shadow-sm
            "
          >

            <div
              class="flex items-center gap-2 text-xs text-neutral-400"
            >

              <span></span>

              <input
                type="text"
                id="searchInput"
                placeholder="제목 또는 본문 검색..."
                class="
                  bg-transparent
                  outline-none
                  w-full
                  text-neutral-800
                  dark:text-neutral-200
                  placeholder-neutral-400
                  text-xs
                "
              />

            </div>

          </div>

        </div>

      </aside>

    </div>

  </div>


  <!--
    ==============================================================
    Script
    ==============================================================
  -->

  <script is:inline define:vars={{ postsData }}>

    /*
     * ============================================================
     * 상태
     * ============================================================
     */

    let currentCategory = 'All';
    let isLatestSort = true;
    let searchQuery = '';

    let isSidebarOpen = true;


    /*
     * ============================================================
     * 게시물 렌더링
     * ============================================================
     */

    function renderPosts() {

      const container = document.getElementById('postContainer');
      const noResults = document.getElementById('noResults');
      const countNum = document.getElementById('countNum');

      if (!container || !noResults || !countNum) {
        return;
      }


      let filtered = postsData.filter(post => {

        const matchCategory =
          currentCategory === 'All' ||
          post.category === currentCategory;


        const query =
          searchQuery
            .toLowerCase()
            .trim();


        const matchSearch =
          query === '' ||
          post.title.toLowerCase().includes(query) ||
          post.summary.toLowerCase().includes(query) ||
          post.content.toLowerCase().includes(query);


        return matchCategory && matchSearch;

      });


      /*
       * 날짜 정렬
       */

      filtered.sort((a, b) => {

        const dateA = new Date(a.date).getTime();
        const dateB = new Date(b.date).getTime();

        return isLatestSort
          ? dateB - dateA
          : dateA - dateB;

      });


      /*
       * 카운트
       */

      countNum.innerText = filtered.length;


      /*
       * 결과 없음
       */

      if (filtered.length === 0) {

        container.innerHTML = '';

        noResults.classList.remove('hidden');

        return;
      }


      noResults.classList.add('hidden');


      /*
       * 카드 생성
       */

      container.innerHTML = filtered.map(post => `

        <article
          class="
            bg-white
            dark:bg-[#1E1E1E]
            rounded-2xl
            p-6
            border
            border-[#E5E5E5]
            dark:border-[#2E2E2E]
            shadow-sm
            transition
            hover:border-neutral-400
            dark:hover:border-neutral-500
          "
        >

          <!-- Category / Date -->

          <div
            class="
              flex
              items-center
              justify-between
              text-xs
              text-[#737373]
              mb-2
            "
          >

            <span
              class="
                font-semibold
                px-2
                py-0.5
                rounded
                bg-neutral-100
                dark:bg-neutral-800
                text-neutral-700
                dark:text-neutral-300
              "
            >
              ${post.category}
            </span>

            <time>
              ${post.date}
            </time>

          </div>


          <!-- Title -->

          <a href="/posts/${post.slug}">

            <h3
              class="
                text-base
                sm:text-lg
                font-bold
                text-neutral-900
                dark:text-white
                mb-2
                hover:underline
              "
            >
              ${post.title}
            </h3>

          </a>


          <!-- Summary -->

          <p
            class="
              text-neutral-600
              dark:text-neutral-300
              text-xs
              sm:text-sm
              line-clamp-2
              leading-relaxed
              mb-4
            "
          >
            ${post.summary}
          </p>


          <!-- Bottom -->

          <div
            class="
              text-xs
              text-[#737373]
              flex
              items-center
              justify-between
              pt-3
              border-t
              border-neutral-100
              dark:border-neutral-800
            "
          >
            <a
              href="/posts/${post.slug}"
              class="
                text-neutral-900
                dark:text-white
                font-semibold
                hover:underline
              "
            >
              Read →
            </a>

          </div>

        </article>

      `).join('');

    }


    /*
     * ============================================================
     * Category
     * ============================================================
     */

    document
      .querySelectorAll('.cat-btn')
      .forEach(btn => {

        btn.addEventListener('click', () => {

          currentCategory =
            btn.dataset.cat;


          /*
           * 전체 버튼 스타일 초기화
           */

          document
            .querySelectorAll('.cat-btn')
            .forEach(b => {

              b.className =
                'cat-btn px-4 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition bg-neutral-100 text-neutral-600 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-700';

            });


          /*
           * 현재 버튼
           */

          btn.className =
            'cat-btn px-4 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 shadow-sm';


          renderPosts();

        });

      });


    /*
     * ============================================================
     * Search
     * ============================================================
     */

    const searchInput =
      document.getElementById('searchInput');


    searchInput?.addEventListener('input', (e) => {

      searchQuery =
        e.target.value;

      renderPosts();

    });


    /*
     * ============================================================
     * Sort
     * ============================================================
     */

    const sortBtn =
      document.getElementById('sortBtn');

    const sortLabel =
      document.getElementById('sortLabel');


    sortBtn?.addEventListener('click', () => {

      isLatestSort =
        !isLatestSort;


      if (sortLabel) {

        sortLabel.innerText =
          isLatestSort
            ? 'NEW'
            : 'OLD';

      }


      renderPosts();

    });


    /*
     * ============================================================
     * Sidebar 접기 / 펼치기
     *
     * 글 페이지 Index와 동일한 방식
     *
     * OPEN
     * 280px
     *
     * CLOSED
     * 32px
     * ============================================================
     */

    const sidebar =
      document.getElementById('homeSidebar');

    const sidebarContent =
      document.getElementById('sidebarContent');

    const sidebarHandle =
      document.getElementById('sidebarHandle');

    const sidebarToggleIcon =
      document.getElementById('sidebarToggleIcon');


    function setSidebarState(open) {

      if (!sidebar || !sidebarContent || !sidebarToggleIcon) {
        return;
      }


      isSidebarOpen = open;


      if (open) {

        /*
         * 펼침
         */

        sidebar.style.width = '280px';
        sidebar.style.maxWidth = '30%';

        sidebarContent.style.opacity = '1';
        sidebarContent.style.pointerEvents = 'auto';

        sidebarToggleIcon.innerText = '‹';

      } else {

        /*
         * 접힘
         */

        sidebar.style.width = '2rem';
        sidebar.style.maxWidth = '2rem';

        sidebarContent.style.opacity = '0';
        sidebarContent.style.pointerEvents = 'none';

        sidebarToggleIcon.innerText = '›';

      }

    }


    /*
     * Handle 클릭
     */

    sidebarHandle?.addEventListener('click', (event) => {

      event.stopPropagation();

      setSidebarState(!isSidebarOpen);

    });


    /*
     * 초기 상태
     */

    setSidebarState(true);


    /*
     * ============================================================
     * 최초 렌더링
     * ============================================================
     */

    renderPosts();

  </script>

</BaseLayout>
