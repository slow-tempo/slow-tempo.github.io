---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';


/* ==================================================
   STATIC PATHS
   ================================================== */

export async function getStaticPaths() {

  const posts =
    await getCollection('posts');

  return posts.map((post) => ({

    params: {
      slug:
        post.slug ||
        post.id.replace(
          /\.[^/.]+$/,
          ''
        )
    },

    props: {
      post
    }

  }));

}


/* ==================================================
   POST DATA
   ================================================== */

const { post } =
  Astro.props;


const {
  Content,
  headings
} =
  await render(post);

---


<BaseLayout title={post.data.title}>


  <!-- ==================================================
       KaTeX
       ================================================== -->

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css"
    slot="head"
  />


  <!-- ==================================================
       PAGE CONTAINER
       ================================================== -->

  <div
    class="
      max-w-6xl
      mx-auto

      px-4
      sm:px-6

      py-8

      w-full
    "
  >


    <!-- ==================================================
         MAIN + INDEX
         ================================================== -->

    <div
      id="postLayout"

      class="
        flex
        items-start

        justify-center

        gap-4

        w-full

        min-w-0
      "
    >


      <!-- ==================================================
           ARTICLE
           ================================================== -->

      <main
        id="postMain"

        class="
          flex-none
          min-w-0

          w-[820px]
          max-w-full

          bg-white
          dark:bg-[#1E1E1E]

          p-6
          sm:p-10

          rounded-2xl

          border
          border-[#E5E5E5]
          dark:border-[#2E2E2E]

          shadow-sm

          z-10
        "
      >


        <!-- ==================================================
             POST HEADER
             ================================================== -->

        <header
          id="postHeader"

          class="
            pb-6
            mb-8

            border-b

            border-[#E5E5E5]
            dark:border-[#2E2E2E]
          "
        >

          <div
            class="
              flex
              items-center
              gap-2

              text-xs
              font-semibold

              text-neutral-500
              dark:text-neutral-400

              mb-2
            "
          >

            <span
              class="
                px-2.5
                py-1

                rounded-md

                bg-neutral-100
                dark:bg-neutral-800

                text-neutral-800
                dark:text-neutral-200
              "
            >
              {post.data.category}
            </span>


            <span>
              •
            </span>


            <time>
              {post.data.date}
            </time>

          </div>


          <h1
            id="post-title"

            class="
              text-xl
              sm:text-3xl

              font-extrabold

              text-neutral-900
              dark:text-white

              tracking-tight

              leading-tight

              mt-3

              scroll-mt-24
            "
          >
            {post.data.title}
          </h1>

        </header>


        <!-- ==================================================
             ARTICLE CONTENT
             ================================================== -->

        <article
          id="articleContent"

          class="
            prose

            dark:prose-invert

            max-w-none

            text-neutral-800
            dark:text-neutral-200

            text-sm
            sm:text-base

            leading-relaxed

            space-y-4
          "
        >

          <Content />

        </article>


        <!-- ==================================================
             COMMENTS
             ================================================== -->

        <section
          id="comments"

          class="
            mt-12
            pt-8

            border-t

            border-[#E5E5E5]
            dark:border-[#2E2E2E]
          "
        >

          <h3
            class="
              text-lg
              font-bold

              text-neutral-900
              dark:text-white

              mb-4
            "
          >
            댓글
          </h3>


          <p
            class="
              text-xs

              text-neutral-500
              dark:text-neutral-400
            "
          >
            GitHub 계정으로 댓글을 남길 수 있습니다.
          </p>

        </section>

      </main>



      <!-- ==================================================
           INDEX SLOT
           ================================================== -->

      {headings.length > 0 && (

        <div
          id="tocSlot"

          class="
            shrink-0

            w-[280px]

            relative
          "
        >


          <!-- ==================================================
               INDEX
               ================================================== -->

          <aside
            id="tocSidebar"

            class="
              shrink-0

              w-[280px]
              max-w-[280px]

              sticky
              top-24

              bg-white
              dark:bg-[#1E1E1E]

              rounded-2xl

              border
              border-[#E5E5E5]
              dark:border-[#2E2E2E]

              shadow-sm

              text-xs

              relative

              overflow-hidden

              flex
              flex-col

              min-h-0

              group

              transition-all
              duration-300
              ease-out

              z-[60]
            "
          >


            <!-- ==================================================
                 HANDLE
                 ================================================== -->

            <button
              id="tocHandle"

              type="button"

              aria-label="목차 접기/펼치기"

              class="
                absolute

                left-0
                top-0
                bottom-0

                w-8

                flex
                items-center
                justify-center

                z-20

                bg-neutral-50/50
                dark:bg-neutral-800/30

                group-hover:bg-neutral-200/60
                dark:group-hover:bg-neutral-700/60

                transition-colors
                duration-200

                border-r

                border-[#E5E5E5]/50
                dark:border-[#2E2E2E]/50

                cursor-pointer
              "
            >


              <!-- ==================================================
                   LEFT ARROW
                   ================================================== -->

              <svg
                id="tocArrowLeft"

                xmlns="http://www.w3.org/2000/svg"

                viewBox="0 0 24 24"

                fill="none"

                stroke="currentColor"

                stroke-width="3"

                stroke-linecap="round"

                stroke-linejoin="round"

                class="
                  w-4
                  h-4

                  text-neutral-800
                  dark:text-neutral-100
                "
              >

                <path
                  d="M15 18l-6-6 6-6"
                />

              </svg>


              <!-- ==================================================
                   RIGHT ARROW
                   ================================================== -->

              <svg
                id="tocArrowRight"

                xmlns="http://www.w3.org/2000/svg"

                viewBox="0 0 24 24"

                fill="none"

                stroke="currentColor"

                stroke-width="3"

                stroke-linecap="round"

                stroke-linejoin="round"

                class="
                  hidden

                  w-4
                  h-4

                  text-neutral-800
                  dark:text-neutral-100
                "
              >

                <path
                  d="M9 18l6-6-6-6"
                />

              </svg>

            </button>


            <!-- ==================================================
                 INDEX TITLE
                 고정 영역
                 ================================================== -->

            <div
              class="
                shrink-0

                px-6
                pl-10
                pr-3

                pt-6
                pb-3
              "
            >

              <nav>

                <h2
                  class="
                    font-bold

                    text-neutral-900
                    dark:text-white

                    text-[18px]

                    pb-2

                    border-b

                    border-neutral-100
                    dark:border-neutral-800
