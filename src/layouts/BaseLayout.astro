---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>slew-tempo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <slot name="head" />
</head>
<body class="bg-[#FAFAFA] text-[#171717] dark:bg-[#121212] dark:text-neutral-100 transition-colors duration-200 min-h-screen flex flex-col font-sans">

    <header class="sticky top-0 z-40 w-full backdrop-blur-md bg-[#FAFAFA]/90 dark:bg-[#121212]/90 border-b border-[#E5E5E5] dark:border-[#2E2E2E]">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
            <a href="/" class="text-lg font-bold tracking-tight text-neutral-900 dark:text-white hover:opacity-80 transition">slew-tempo</a>
            <nav class="flex items-center space-x-6 text-sm font-medium">
                <a href="/" class="text-neutral-900 dark:text-white font-semibold">Home</a>
                <a href="#about" class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition">About</a>
            </nav>
            <button onclick="document.documentElement.classList.toggle('dark')" class="p-2 rounded-lg border border-[#E5E5E5] dark:border-[#2E2E2E] text-neutral-600 dark:text-neutral-300">
                <i class="fa-solid fa-moon dark:hidden text-xs"></i>
                <i class="fa-solid fa-sun hidden dark:block text-xs"></i>
            </button>
        </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 pb-12 w-full flex-grow grid grid-cols-1 lg:grid-cols-12 gap-8">
        <slot />
    </main>

    <footer class="border-t border-[#E5E5E5] dark:border-[#2E2E2E] py-6 text-center text-xs text-[#737373]">
        © 2026 slew-tempo. All rights reserved.
    </footer>
</body>
</html>
